# ── Bot Config ────────────────────────────────────────────
BOT_TOKEN=                        # @BotFather se milega
API_ID=                           # my.telegram.org
API_HASH=                         # my.telegram.org
OWNER_ID=                         # Tera Telegram user ID

# ── Sudo Users ────────────────────────────────────────────
SUDO_USERS=                       # Space separated IDs  e.g: 123456 789012

# ── MongoDB ───────────────────────────────────────────────
MONGO_URI=                        # mongodb+srv://user:pass@cluster.mongodb.net/
DB_NAME=waifuscrper               # Database ka naam  e.g: waifuscrper
COLLECTION_NAME=waifus            # Collection ka naam  e.g: waifus

# ── Logger ────────────────────────────────────────────────
LOGGER_ID=                        # Log group/channel ka ID  e.g: -100xxxxxxxxxx

# ── Target Channel ────────────────────────────────────────
TARGET_CHANNEL=                   # Jis channel se waifu scrape karna hai (@channel or -100xxx)

# ── Userbot (String Session) ──────────────────────────────
STRING_SESSION=                   # Pyrogram string session (/setsession se generate hoga)

# ── Waifu Settings ────────────────────────────────────────
APPROVE_MODE=false                # true = logger pe approve mangega, false = auto approve
AUTO_FETCH_NEW=false              # true = naye waifu auto fetch, false = off

# ── Image Upload ──────────────────────────────────────────
CATBOX_HASH=                      # catbox.moe user hash (account se milega)
IMGBB_KEY=                        # api.imgbb.com API key (fallback uploader)

# ── Keyword / Caption Parsing ─────────────────────────────
RARITY_KEYWORD=Rarity             # Caption mein rarity dhundne ka keyword
